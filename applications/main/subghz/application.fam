App(
    appid="subghz",
    name="Sub-GHz",
    apptype=FlipperAppType.MENUEXTERNAL,
    targets=["f7"],
    # Upstream runs this app's ~45 KB of code from flash. From the SD card it would
    # sit on the heap, and then the Frequency Analyzer plugin could not load
    # ("Analyzer plugin is missing or outdated"). ForceXIP moves it to the XIP
    # region instead. Confirmed on hardware.
    flags=["ForceXIP"],
    cdefines=["APP_SUBGHZ"],
    entry_point="subghz_app",
    requires=[
        "gui",
        "cli",
        "dialogs",
    ],
    provides=[
        "subghz_load_dangerous_settings",
    ],
    icon="A_Sub1ghz_14",
    stack_size=3 * 1024,
    order=1,
    resources="resources",
    # plugins/ ships as .fal - keep it out of the image. Exclusions are leaf names, not paths.
    sources=["*.c*", "!plugins"],
    fap_libs=["assets", "hwdrivers"],
    fap_icon="icon.png",
    fap_category="Sub-GHz",
    fap_exclude_libs=["gcc"],
)

App(
    appid="cli_subghz",
    targets=["f7"],
    apptype=FlipperAppType.PLUGIN,
    entry_point="cli_subghz_ep",
    requires=["cli"],
    sources=["subghz_cli.c", "helpers/subghz_chat.c"],
)

App(
    appid="subghz_load_dangerous_settings",
    apptype=FlipperAppType.STARTUP,
    entry_point="subghz_dangerous_freq",
    requires=["storage", "subghz"],
    # Name the one file this hook needs. With the app itself external, nothing
    # else here narrows the firmware build, and the default glob would pull in
    # both scenes/ and plugins/add_manually/, which define the same scenes.
    sources=["subghz_dangerous_freq.c", "subghz_last_settings.c"],
    order=650,
)

# Feature plugins: loaded on demand by the app, so their code is not resident in the firmware.
App(
    appid="subghz_add_manually",
    apptype=FlipperAppType.PLUGIN,
    targets=["f7"],
    entry_point="subghz_add_manually_ep",
    requires=["subghz"],
    sources=["plugins/add_manually/*.c"],
)

App(
    appid="subghz_frequency_analyzer",
    apptype=FlipperAppType.PLUGIN,
    targets=["f7"],
    entry_point="subghz_frequency_analyzer_ep",
    requires=["subghz"],
    sources=["plugins/frequency_analyzer/*.c"],
    # The worker drives the CC1101 registers directly, so hwdrivers puts a second copy of those
    # 320 bytes in the .fal. Exporting them from the firmware instead would trade SD/RAM bytes
    # for resident flash, which is the wrong way round here.
    fap_libs=["assets", "hwdrivers"],
    fap_exclude_libs=["gcc"],
)
