App(
    appid="archive",
    name="Archive",
    # Runs from the SD card rather than firmware, to leave room for the XIP
    # region without taking any export off the firmware API. The desktop opens
    # it by path; see ARCHIVE_APP_PATH in desktop_scene_main.c.
    apptype=FlipperAppType.EXTERNAL,
    entry_point="archive_app",
    requires=["gui"],
    stack_size=6 * 1024,
    fap_category="Tools",
    fap_libs=["assets"],
    fap_exclude_libs=["gcc"],
    order=10,
)
